# App
APP_ENV=development
SECRET_KEY=change-me-in-production

# OpenAI (optional, not used by default)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Groq (used for GenAI features)
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama3-70b-8192
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_TRANSCRIPTS=meeting.transcripts
KAFKA_TOPIC_SPEAKERS=meeting.speakers
KAFKA_TOPIC_SUMMARIES=meeting.summaries
KAFKA_TOPIC_ACTION_ITEMS=meeting.action_items
KAFKA_TOPIC_ALERTS=meeting.alerts

# ChromaDB
CHROMA_PERSIST_DIR=./data/chroma

# Database
DATABASE_URL=sqlite+aiosync:///./data/meetings.db

# Whisper
WHISPER_MODEL=base
